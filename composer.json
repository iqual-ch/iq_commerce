{
  "name": "iqual/iq_commerce",
  "description": "Provides additional functionality for the Drupal Commerce",
  "type": "drupal-custom-module",
  "repositories": [
    {
      "type": "composer",
      "url": "https://github.com/iqual-ch/iq_commerce"
    }
  ],
  "require": {
    "php": "^8.1",
    "drupal/core": "^10 || ^11",
    "drupal/commerce": "^3.2",
    "drupal/hierarchical_taxonomy_menu": "^3.0@alpha",
    "drupal/media_entity_browser": "^3.0",
    //"drupal/commerce_variation_add_to_cart": "^2.0",
    "drupal/commerce_variation_cart_form": "^1.5",
    "drupal/commerce_shipping": "^2.15",
    "drupal/pagedesigner_block_adaptable": "^4.1",
    "iqual/iq_progressive_decoupler": "^3.0",
    "drupal/term_reference_tree": "^2.0",
    "drupal/twig_tweak": "^3.4",
    "drupal/symfony_mailer": "^1.6",
    "drupal/commerce_cart_api": "^1.9",
    "iqual/iq_entity_browsers": "^3.1",
    "drupal/commerce_combine_carts": "^1.1",
    "drupal/login_emailusername": "^3.0",
    "drupal/redirect_after_login": "^3.0",
    "drupal/single_datetime": "^2.0@beta",
    "drupal/entity_print": "^2.18",
    "drupal/commerce_repeat_order": "^2.4"
  },
  "extra": {
    "patches": {
      "drupal/redirect_after_login" : {
        "[https://dgo.to/3201520]: Allow other modules to prevent redirection": "https://git.drupalcode.org/project/redirect_after_login/-/merge_requests/16.diff"
      }/*,
       "drupal:/commerce_variation_add_to_cart" : {
        "[https://dgo.to/3429417]: Drupal 11 Compatibility": "https://git.drupalcode.org/project/commerce_variation_add_to_cart/-/merge_requests/3/diffs.diff?diff_id=1909057"
      } */
    }
  }
}
